FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends cron && rm -rf /var/lib/apt/lists/*

RUN pip install uv

ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g ${APP_GID} sisillm && useradd -m -u ${APP_UID} -g ${APP_GID} sisillm || true

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

RUN mkdir -p ./tmp/images

COPY docker/crontab.sync /etc/cron.d/bci_sync
RUN chmod 0644 /etc/cron.d/bci_sync && crontab /etc/cron.d/bci_sync

RUN chown -R sisillm:sisillm /app
RUN mkdir -p /app/.cache/uv && chown -R sisillm:sisillm /app/.cache

CMD printenv | grep -v "^HOSTNAME\|^HOME\|^PWD\|^SHLVL\|^PATH\|^_=" >> /etc/environment && cd /app && uv run python mcp_conductor/entry/main_sync_bci_data.py ; cron -f
