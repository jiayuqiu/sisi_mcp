PATH=/usr/local/bin:/usr/bin:/bin

# Run the scripts on the day before yesterday (l2d), as the latency of the base data is 2 day.
# sync metrics data
0 12 * * * cd /app && uv run python mcp_conductor/entry/main_sync_bci_data.py --start-date=$(date -d '2 days ago' +\%Y-\%m-\%d) --end-date=$(date -d '2 days ago' +\%Y-\%m-\%d)>> /var/log/bci_sync.log 2>&1

# traffic detect task
0 13 * * * cd /app && uv run python mcp_conductor/entry/main_traffic_detect.py --run_date=$(date -d '2 days ago' +\%Y-\%m-\%d) >> /var/log/traffic_detect.log 2>&1

# for in case, run the day before yesterday.
0 14 * * * cd /app && uv run python -m mcp_conductor.entry.main_trigger_dify_chatflow --start-date $(date -d '2 days ago' +\%Y-\%m-\%d) --end-date $(date -d '2 days ago' +\%Y-\%m-\%d) --sleep 2 >> /var/log/trigger_chatflow.log 2>&1
